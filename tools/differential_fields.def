/* Shared strict v1 schema: WORD(address, name, C expression), or ACTOR_WORD
 * (offset, name, C expression). All outputs are unsigned 16-bit words.
 * No sentinel filtering. Native fractional low bytes are NOT discarded.
 * This is an explicitly partial authoritative state projection, not all RAM.
 * Ambiguous split +60 timers are excluded until a canonical mapping exists. */
WORD(0x07F6, "rng", t->rng.state)
WORD(0x085C, "camera.x", t->camera.x)
WORD(0x0860, "camera.y", t->camera.y)
WORD(0x08BC, "camera.alternate", t->camera_alternate_raw_08bc)
WORD(0x08CC, "camera.alternate_mode", t->camera_alternate_mode_raw_08cc)
WORD(0x0926, "period", t->period_raw_0926)
WORD(0x0928, "clock", t->match_clock_raw_0928)
WORD(0x092C, "shot_clock", t->rim_raw_092c)
WORD(0x0932, "tip_winner_group", t->tip_winner_group_raw_0932)
WORD(0x0936, "live_state", t->live_state_raw)
WORD(0x093A, "active_group", t->camera_side_group_raw == 255 ? 65535 : t->camera_side_group_raw)
WORD(0x093E, "owner", t->possession_actor)
WORD(0x0942, "pass_source", t->pass_actor_raw)
WORD(0x0944, "pass_aux", t->pass_aux_raw)
WORD(0x0946, "receiver", t->pass_receiver_raw)
WORD(0x0948, "ball_activity", t->ball_activity_raw)
WORD(0x094A, "launch_latch", t->rim_raw_094a)
WORD(0x094C, "shot_value", t->shot_value_raw)
WORD(0x0952, "inbound_state", t->inbound_state_raw)
WORD(0x0954, "inbound_actor", t->inbound_actor_raw)
WORD(0x096A, "rim_context", t->rim_raw_096a)
WORD(0x0994, "play_request", t->play_request_raw)
WORD(0x0996, "play", t->play_code)
WORD(0x0998, "play_step", t->play_step_raw)
WORD(0x099A, "play_countdown", t->play_countdown_raw)
WORD(0x099C, "play_mirror", t->play_mirror_raw)
WORD(0x099E, "play_wait", t->play_event_wait_raw)
WORD(0x09B6, "whistle", t->fouls.whistle_active_raw_09b6)
WORD(0x09B8, "transfer", t->inbound_transfer_raw)
WORD(0x09C4, "pass_active", t->pass_active_raw)
WORD(0x09D6, "role_rebuild", t->role_rebuild_raw_09d6)
WORD(0x13E7, "event_bits", t->rim_raw_13e7)
WORD(0x13E9, "tip_events", t->tip_event_bits_raw_13e9)
WORD(0x3EED, "ball.x_fraction", (uint32_t)t->ball.x_fp << 8)
WORD(0x3EEF, "ball.x_integer", (uint32_t)t->ball.x_fp >> 8)
WORD(0x3EF1, "ball.y_fraction", (uint32_t)t->ball.y_fp << 8)
WORD(0x3EF3, "ball.y_integer", (uint32_t)t->ball.y_fp >> 8)
WORD(0x3EF5, "ball.z_fraction", (uint32_t)t->ball.z_fp << 8)
WORD(0x3EF7, "ball.z_integer", (uint32_t)t->ball.z_fp >> 8)
WORD(0x3EF9, "ball.vx", t->ball.velocity_x)
WORD(0x3EFB, "ball.vy", t->ball.velocity_y)
WORD(0x3EFD, "ball.vz", t->ball.velocity_z)
ACTOR_WORD(0x02, "x_fraction", (uint32_t)a->x_fp << 8)
ACTOR_WORD(0x04, "x_integer", (uint32_t)a->x_fp >> 8)
ACTOR_WORD(0x06, "y_fraction", (uint32_t)a->y_fp << 8)
ACTOR_WORD(0x08, "y_integer", (uint32_t)a->y_fp >> 8)
ACTOR_WORD(0x0A, "z_fraction", (uint32_t)a->z_fp << 8)
ACTOR_WORD(0x0C, "z_integer", (uint32_t)a->z_fp >> 8)
ACTOR_WORD(0x0E, "vx", a->velocity_x)
ACTOR_WORD(0x10, "vy", a->velocity_y)
ACTOR_WORD(0x12, "vz", a->velocity_z)
