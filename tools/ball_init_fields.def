/* WORD(native address, field). Descriptor addresses depend on ENTRY cursor. */
WORD(0x009A, cursor)
WORD(cursor, descriptor_record)
WORD((uint16_t)(cursor+2u), descriptor_terminator)
WORD(0x3EFF, ball_descriptor)
WORD(0x08FE, object_list_raw_08fe)
WORD(0x0910, published_record)
WORD(0x3EED, x_fraction)
WORD(0x3EEF, x)
WORD(0x3EF1, y_fraction)
WORD(0x3EF3, y)
WORD(0x3EF5, z_fraction)
WORD(0x3EF7, z)
WORD(0x3EF9, velocity_x)
WORD(0x3EFB, velocity_y)
WORD(0x3EFD, velocity_z)
WORD(0x3F59, group)
WORD(0x3EEB, record_id)
WORD(0x4933, context_4933)
WORD(0x4935, context_4935)
WORD(0x08F0, event_08f0)
